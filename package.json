{
  "name": "remnawave-mcp",
  "version": "0.3.0",
  "description": "Publishable stdio MCP server for verified Remnawave diagnostics, inventory reads, and guarded mutation flows.",
  "type": "module",
  "bin": {
    "remnawave-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remnawave",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jewsh1r/remnawave-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Jewsh1r/remnawave-mcp/issues"
  },
  "homepage": "https://github.com/Jewsh1r/remnawave-mcp#readme",
  "packageManager": "npm@10.9.2",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "extract:remnawave-openapi": "tsx scripts/extract-remnawave-openapi.ts",
    "generate:remnawave-operation-inventory": "tsx scripts/generate-remnawave-operation-inventory.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@remnawave/backend-contract": "3.2.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "license": "MIT"
}
