{
  "name": "@indiebrothers/mcp-remnawave",
  "version": "0.1.0",
  "private": true,
  "description": "Stdio-only MCP server for verified Remnawave 2.7.3 diagnostics, inventory reads, and guarded mutation flows.",
  "type": "module",
  "bin": {
    "mcp-remnawave": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.11.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "remnawave",
    "stdio"
  ],
  "packageManager": "npm@10.9.2",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "extract:remnawave-openapi": "tsx scripts/extract-remnawave-openapi.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@remnawave/backend-contract": "^2.7.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
